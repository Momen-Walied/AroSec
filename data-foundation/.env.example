# Vigilance Data Foundation — environment configuration.
# Copy to .env and adjust. Never commit .env.

# sample = download/extract only enough representative data to build+verify the full pipeline.
# full   = download the complete dataset (may be many GB). Check sizes first.
DATA_MODE=sample

# Project root (absolute path). Defaults to the repository root if unset.
# VIGILANCE_DATA_ROOT=

# Base directory for raw downloads (default: data/raw).
# RAW_DATA_DIR=data/raw

# Default temporal aggregation window. One of: 5s, 30s, 60s.
DEFAULT_WINDOW=30s

# Comma-separated analytics windows to materialize.
ENABLED_WINDOWS=5s,30s,60s

# Per-dataset sample caps (rows) used in DATA_MODE=sample to bound disk/memory.
SAMPLE_MAX_FLOW_ROWS=200000
SAMPLE_MAX_PCAP_PACKETS=50000
SAMPLE_MAX_PROVENANCE_ROWS=500000

# Optional Neo4j export/load (never required for the core pipeline).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional network tuning for downloads.
HTTP_TIMEOUT_SECONDS=60
# Some hosts (e.g. UNB CIC) gate downloads behind a registration form.
# Set to true ONLY if you have independently obtained the file and placed it in data/raw/<dataset>/.
ALLOW_REGISTRATION_GATED=false
